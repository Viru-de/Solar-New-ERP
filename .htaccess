# ==============================================================================
# SolarPulse ERP + CRM - Production Apache & LiteSpeed Configuration for Hostinger
# ==============================================================================
#
# This configuration guarantees that deep-link page refreshes on Hostinger shared
# hosting (e.g. /dashboard, /leads, /customers, /projects, /finance, /hrms, /settings)
# are seamlessly rewritten to /index.html instead of returning 404 Not Found errors.
# ==============================================================================

# Prevent directory listings
Options -Indexes

# Disable MultiViews to prevent Apache content-negotiation conflicts with route paths
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Set default document
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Define base directory (adjust to /subfolder/ if deployed in a subdirectory)
  RewriteBase /

  # ----------------------------------------------------------------------------
  # 1. Security: Block hidden files, git, env, and database dumps
  # ----------------------------------------------------------------------------
  RewriteRule "(^|/)\.(?!well-known)" - [F]
  RewriteRule \.(env|git|sql|md|log)$ - [F,L]

  # ----------------------------------------------------------------------------
  # 2. Existing Files & Directories: Serve directly without rewriting
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ----------------------------------------------------------------------------
  # 3. Server-Side PHP API Endpoints in api/
  # ----------------------------------------------------------------------------
  # Allow direct execution of existing PHP scripts
  RewriteCond %{REQUEST_URI} ^/api/.*\.php$ [NC]
  RewriteRule ^ - [L]

  # Clean API URLs: route /api/<name> to /api/<name>.php if the PHP script exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^api/(.*)$ api/$1.php [L,QSA]

  # ----------------------------------------------------------------------------
  # 4. Single Page Application (SPA) Deep-Link Fallback Rule
  # ----------------------------------------------------------------------------
  # Never rewrite index.html itself to prevent infinite loops
  RewriteRule ^index\.html$ - [L]

  # For any route (/dashboard, /leads, /customers, /projects, /finance, /hrms, /settings, etc.)
  # rewrite the request to index.html so the client-side React router resolves it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# MIME Type Definitions for Modern JavaScript ES Modules & Web Assets
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

# ------------------------------------------------------------------------------
# Browser Caching Headers
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML & JSON: Do NOT cache index.html long-term so new deployments reflect immediately
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"

  # Version-hashed static JavaScript & CSS chunks (1 year cache)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Media & Fonts
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# Gzip / Deflate Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
